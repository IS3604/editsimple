# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Not used by the MVP request path (all queries run as the signed-in user under RLS).
# Keep it here only for admin scripts. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Text generation ----------
# Which provider writes copy: "groq" (fast, default) or "openai"
TEXT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# ---------- Image generation ----------
# "openai" (uses OPENAI_API_KEY + OPENAI_IMAGE_MODEL) or "none" (theme gradients only, no AI images)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- Keyword / trend research ----------
# YouTube Data API v3 (Google Cloud API key). Enables: recent-video engagement stats + trending videos.
YOUTUBE_API_KEY=
# Region used for YouTube trending + Ads geo (ISO 3166-1 alpha-2)
RESEARCH_REGION=IN
RESEARCH_LANGUAGE=en

# Google Ads API — Keyword Planner (optional but the ONLY official source of search volume/competition).
# Needs an approved developer token + OAuth refresh token for an Ads account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Manager account id if the customer is accessed through an MCC (digits only)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
# Geo target constant (2356 = India, 2840 = USA) and language constant (1000 = English)
GOOGLE_ADS_GEO_TARGET=2356
GOOGLE_ADS_LANGUAGE=1000

# Wikimedia REST API needs no key; set a contact UA per their policy.
WIKIMEDIA_USER_AGENT=EditSimple/0.1 (contact@example.com)
